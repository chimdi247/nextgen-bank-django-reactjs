  {
   "id": 4,
   "type": "stat",
   "title": "Cache hit ratio",
   "description": "hits / (hits + misses). Throttling counters miss on first use, so a healthy API sits well below 100 %.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(redis_keyspace_hits_total[$__range])) / (sum(rate(redis_keyspace_hits_total[$__range])) + sum(rate(redis_keyspace_misses_total[$__range])))",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 50
       },
       {
        "color": "green",
        "value": 80
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
