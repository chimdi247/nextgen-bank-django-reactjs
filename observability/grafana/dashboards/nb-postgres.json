{
 "uid": "nb-postgres",
 "title": "NextGen Bank - PostgreSQL",
 "tags": [
  "nextgen",
  "postgres",
  "database"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "title": "NextGen Bank dashboards",
   "tags": [
    "nextgen"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "db",
    "label": "Database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(pg_stat_database_numbackends{datname!~\"template.*|postgres\"}, datname)",
     "refId": "v-db"
    },
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "max_connections",
    "type": "constant",
    "query": "100",
    "hide": 2,
    "skipUrlSync": true,
    "label": "max_connections"
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "red",
    "builtIn": 1
   }
  ]
 },
 "panels": [
