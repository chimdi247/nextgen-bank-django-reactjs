  "from": "now-30m",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "title": "NextGen Bank dashboards",
   "tags": [
    "nextgen"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "testid",
    "label": "Test run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "refresh": 2,
    "sort": 2,
    "query": {
     "query": "label_values(k6_vus, testid)",
     "refId": "v-testid"
    },
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "red",
    "builtIn": 1
   }
  ]
 },
