# =============================================================================
# NextGen Bank - LOCAL environment (docker compose -f local.yml up --build)
# Read by every Python container (env_file) and, for POSTGRES_*, by the postgres containers.
# =============================================================================

# ---- Django
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=False
SITE_NAME="NextGen Bank"
SECRET_KEY=gdgVqkMGn6HnU19Gjvav6CqjkZtt4VeLSVLCuAc6Je4TITKOLpRZU9Vo4lS8etLHj00
SIGNING_KEY=S-MHaiN4TAb_ERc1Fk_vB7vYUq1nMNt93-6LzMlv-4ayuN_62ur1ugTuaLn3OQrCAT8
ADMIN_URL=supersecret/
DOMAIN=34.171.152.81:8080
CSRF_TRUSTED_ORIGINS=http://34.171.152.81:8080
MEDIA_PUBLIC_URL=http://34.171.152.81:8080
COOKIE_SECURE=False
LOG_LEVEL=INFO

# Rate limits. The shipped 50 / 100 requests per DAY made the UI unusable; load tests need far more headroom
THROTTLE_ANON_RATE=600/minute
THROTTLE_USER_RATE=6000/minute
JWT_ACCESS_MINUTES=30
OTP_EXPIRATION_MINUTES=5
LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=1

# ---- Mail (Mailpit catches everything: http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@nextgenbank.local
ADMIN_EMAIL=admin@example.com

# ---- PostgreSQL. The application talks to PgBouncer (transaction pooling), PgBouncer talks to postgres.
POSTGRES_DB=banker
POSTGRES_USER=banker
POSTGRES_PASSWORD=banker_local_password
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
REPLICATION_PASSWORD=replicator_local_password
DB_CONN_MAX_AGE=0
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=300
PGBOUNCER_DEFAULT_POOL_SIZE=20

# ---- Celery / RabbitMQ / Redis
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit_local_password
CELERY_BROKER_URL=amqp://rabbit:rabbit_local_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=flower
CELERY_CONCURRENCY=2

# ---- Banking rules
BANK_NAME="NextGen Bank"
BANK_CODE=100
BANK_BRANCH_CODE=01
CURRENCY_CODE_USD=1
CURRENCY_CODE_GBP=2
CURRENCY_CODE_KES=3
BANK_CARD_PREFIX=4
BANK_CARD_CODE=1234
CVV_SECRET_KEY=qFz0Zeht3TOCgwhDLB-Rlba-tmEhDYMY
LARGE_TRANSACTION_THRESHOLD=10000
FREQUENT_TRANSACTION_THRESHOLD=10
TIME_WINDOW_HOURS=24

# ---- Profile images. Leave empty to store them on local disk (served at /media/); set to use Cloudinary.
CLOUDINARY_CLOUD_NAME=dmyr68awx
CLOUDINARY_API_KEY=159585475319587
CLOUDINARY_API_SECRET=TQqGLre3fE2Md6lPcunQqPMpLlg

# ---- Grafana (observability/) - alert e-mails go over SMTP to Mailpit by default

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alerts@nextgenbank.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS
ALERT_EMAIL_TO=shimdi247@gmail.com

# ---- Exporters (read from this file via env_file; keep in sync with POSTGRES_* above)
DATA_SOURCE_NAME=postgresql://banker:banker_local_password@postgres:5432/banker?sslmode=disable
PGBOUNCER_EXPORTER_CONNECTION_STRING=postgres://banker:banker_local_password@pgbouncer:6432/pgbouncer?sslmode=disable
REDIS_ADDR=redis://redis:6379
